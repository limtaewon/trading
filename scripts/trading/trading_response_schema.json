{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenClaw Trading Decision (Strict)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "market_assessment",
    "regime_action",
    "orders",
    "risk_targets",
    "watch_list",
    "portfolio_advice",
    "self_evaluation",
    "next_focus"
  ],
  "properties": {
    "execution_mode": {
      "type": "string",
      "enum": ["normal", "shock", "recovery", "close_only"]
    },
    "timestamp": { "type": "string" },
    "market_assessment": { "type": "string" },
    "regime_action": {
      "type": "string",
      "enum": ["aggressive", "normal", "cautious", "defensive"]
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "ticker",
          "ticker_name",
          "quantity",
          "order_type",
          "confidence",
          "reasoning"
        ],
        "properties": {
          "action": { "type": "string", "enum": ["BUY", "SELL"] },
          "ticker": { "type": "string", "pattern": "^[0-9]{6}$" },
          "ticker_name": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 },
          "order_type": { "type": "string", "enum": ["LIMIT", "MARKET"] },
          "price": { "type": "number", "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reasoning": { "type": "string", "minLength": 1 },
          "event_signature": { "type": "string", "maxLength": 64 },
          "strategy_family": {
            "type": "string",
            "enum": [
              "stock_selection",
              "index_etf",
              "shock_hedge",
              "shock_rebound",
              "core_defensive",
              "forced_exit"
            ]
          },
          "playbook_id": { "type": "string", "maxLength": 64 },
          "priority": { "type": "integer", "minimum": 1, "maximum": 10 },
          "close_only": { "type": "boolean" },
          "expected_holding_window": {
            "type": "string",
            "enum": ["intraday", "1d", "1-3d", "1w", "1-2w", "2w+"]
          },
          "event_type": {
            "type": "string",
            "enum": [
              "earnings",
              "guidance",
              "policy",
              "regulation",
              "mna",
              "supply_chain",
              "rate_fx",
              "commodity",
              "geopolitical",
              "litigation",
              "product",
              "incident",
              "buyback_dividend",
              "capital_raise",
              "insider",
              "macro_data",
              "index_flow",
              "other",
              "hard_exit",
              "dynamic_exit"
            ]
          },
          "time_horizon": {
            "type": "string",
            "enum": ["intraday", "1d", "1-3d", "1w", "1-2w", "2w+"]
          },
          "lag_hours": { "type": "integer", "minimum": 0, "maximum": 336 },
          "channels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "revenue",
                "cost",
                "margin",
                "demand",
                "supply",
                "liquidity",
                "valuation",
                "policy",
                "fx",
                "commodity",
                "rate",
                "risk",
                "sentiment",
                "other"
              ]
            }
          },
          "thesis_path": { "type": "string", "maxLength": 280 },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "maxLength": 300 }
          },
          "evidence_urls": {
            "type": "array",
            "items": { "type": "string", "maxLength": 500 }
          },
          "invalidation": { "type": "string", "maxLength": 280 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "order_type": { "const": "LIMIT" } },
              "required": ["order_type"]
            },
            "then": {
              "required": ["price"],
              "properties": { "price": { "type": "number", "exclusiveMinimum": 0 } }
            }
          },
          {
            "if": {
              "properties": { "action": { "const": "BUY" } },
              "required": ["action"]
            },
            "then": {
              "required": ["time_horizon", "thesis_path"],
              "anyOf": [
                {
                  "required": ["evidence_refs"],
                  "properties": { "evidence_refs": { "type": "array", "minItems": 1 } }
                },
                {
                  "required": ["evidence_urls"],
                  "properties": { "evidence_urls": { "type": "array", "minItems": 1 } }
                }
              ]
            }
          }
        ]
      }
    },
    "risk_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticker",
          "ticker_name",
          "take_profit_pct",
          "stop_loss_pct",
          "confidence",
          "time_horizon",
          "reasoning"
        ],
        "properties": {
          "ticker": { "type": "string", "pattern": "^[0-9]{6}$" },
          "ticker_name": { "type": "string", "minLength": 1 },
          "take_profit_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.6 },
          "stop_loss_pct": { "type": "number", "minimum": -0.6, "exclusiveMaximum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "time_horizon": {
            "type": "string",
            "enum": ["intraday", "1d", "1-3d", "1w", "1-2w", "2w+"]
          },
          "reasoning": { "type": "string", "minLength": 1, "maxLength": 400 },
          "invalidation": { "type": "string", "maxLength": 280 }
        }
      }
    },
    "watch_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "ticker_name", "reason"],
        "properties": {
          "ticker": { "type": "string", "pattern": "^[0-9]{6}$" },
          "ticker_name": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "portfolio_advice": { "type": "string" },
    "self_evaluation": { "type": "string" },
    "next_focus": { "type": "string" }
  }
}
