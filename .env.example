# Core runtime
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASS=
CLICKHOUSE_DB=trading

# Naver News API (required for collect_news.py / monitor_news.py)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Telegram (required for morning_briefing.py direct send)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional providers / notifications
DOORAY_WEBHOOK_URL=
DART_API_KEY=
ECOS_API_KEY=
GEMINI_API_KEY=

# Trading LLM safety defaults
OPENCLAW_PRIMARY_MODEL=gpt-5.4
OPENCLAW_FALLBACK_MODEL=gpt-5.4
CODEX_MODEL=gpt-5.4
WATCHLIST_ACTIVE_SOURCE=gpt54_shadow
CODEX_BIN=openclaw
ENABLE_CODEX_EXEC_FALLBACK=0
CODEX_SPARK_FALLBACK_ON_ANY_ERROR=0
CODEX_FALLBACK_ON_ANY_ERROR=0
